# Copy to .env and adjust. Every variable is optional.

# Port of the status page and MCP endpoint (http://localhost:3333/mcp)
PORT=3333

# Require "Authorization: Bearer <token>" for /mcp and uploads. Set it if the server is reachable by anyone but you.
MCP_AUTH_TOKEN=

# Only sync these Search Console properties (comma-separated). Empty = every property the service account can read.
# GSC_SITES=sc-domain:example.com,https://blog.example.com/

# Brand terms for branded / non-branded split (comma-separated, can also be set per site with the set_brand_names tool)
BRAND_NAMES=

# How often to pull fresh data (hours, 0 = only at start)
SYNC_INTERVAL_HOURS=6

# How much history to import on the first run (max 16 — what Search Console keeps). Data is kept locally forever after that.
HISTORY_MONTHS=16

# Parallel days fetched from the Search Console API
SYNC_CONCURRENCY=4

# URL Inspection checks per site per sync (Google allows 2000/day per property). 0 disables indexing checks.
INSPECTION_DAILY_LIMIT=100

# ClickHouse password (used by both containers)
CLICKHOUSE_PASSWORD=gsc-local-password

# Public URL shown in snippets, e.g. when running behind a reverse proxy
PUBLIC_URL=http://localhost:3333
